<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="${ctx}/home" aria-label="墨卷书阁首页">
            <span class="brand-mark">墨</span>
            <span class="brand-text">
                <strong>墨卷书阁</strong>
                <small>LIBRARY SYSTEM</small>
            </span>
        </a>

        <form class="global-search" action="${ctx}/search" method="get" role="search">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M20 20l-3.2-3.2"></path>
            </svg>
            <input type="text" name="keyword" value="${fn:escapeXml(keyword)}"
                   placeholder="搜索书名、作者或出版社" autocomplete="off">
            <button type="submit">检索</button>
        </form>

        <nav class="topnav" aria-label="主导航">
            <a class="nav-link ${activeNav eq 'home' ? 'active' : ''}" href="${ctx}/home">首页</a>
            <a class="nav-link ${activeNav eq 'search' ? 'active' : ''}" href="${ctx}/search">全部图书</a>
            <a class="nav-link ${activeNav eq 'bookshelf' ? 'active' : ''}" href="${ctx}/bookshelf">我的书架</a>
            <a class="nav-link" href="${ctx}/book?action=myUploads">我的上传</a>
            <a class="nav-link" href="${ctx}/notification">通知<c:if test="${unreadNotifCount > 0}"><b class="notif-badge">${unreadNotifCount}</b></c:if></a>
            <c:if test="${loginUser.admin}">
                <a class="nav-link" href="${ctx}/admin">管理<c:if test="${pendingBookCount > 0}"><b class="notif-badge">${pendingBookCount}</b></c:if></a>
            </c:if>
            <span class="nav-divider"></span>

            <div class="user-menu" id="userMenu">
                <button type="button" class="user-chip" aria-haspopup="true" aria-expanded="false">
                    <span class="avatar"><c:out value="${loginUser.avatarText}"/></span>
                    <span class="user-meta">
                        <strong><c:out value="${loginUser.displayName}"/></strong>
                        <small>${loginUser.admin ? '管理员' : '读者'}</small>
                    </span>
                    <span class="user-caret" aria-hidden="true">▾</span>
                </button>
                <div class="user-dropdown" role="menu">
                    <div class="dropdown-head">
                        <span class="avatar avatar-lg"><c:out value="${loginUser.avatarText}"/></span>
                        <div>
                            <strong><c:out value="${loginUser.displayName}"/></strong>
                            <small><c:out value="${loginUser.email}"/></small>
                        </div>
                    </div>
                    <a class="dropdown-item" href="${ctx}/user?action=profile" role="menuitem">
                        <span class="dropdown-icon">◉</span>个人主页
                    </a>
                    <a class="dropdown-item" href="${ctx}/bookshelf" role="menuitem">
                        <span class="dropdown-icon">▤</span>我的书架
                    </a>
                    <a class="dropdown-item" href="${ctx}/user?action=notes" role="menuitem">
                        <span class="dropdown-icon">✎</span>我的笔记
                    </a>
                    <a class="dropdown-item" href="${ctx}/user?action=settings" role="menuitem">
                        <span class="dropdown-icon">⚙</span>设置
                    </a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item dropdown-danger" href="${ctx}/auth?action=logout" role="menuitem">
                        <span class="dropdown-icon">⇥</span>退出登录
                    </a>
                </div>
            </div>
        </nav>
    </div>
</header>
<script>
    (function () {
        try {
            var lang = '${loginUser.lang}';
            if (lang === 'en' || lang === 'zh') {
                localStorage.setItem('siteLang', lang);
            }
        } catch (e) {
        }
    })();
</script>
<script defer src="${ctx}/assets/js/i18n.js?v=20"></script>
